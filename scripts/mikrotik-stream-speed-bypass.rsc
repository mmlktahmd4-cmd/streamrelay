# ═══════════════════════════════════════════════════════════════
# StreamRelay — استثناء سرعة سيرفر البث من حد سرعة العميل
# الهدف: ترافيك العميل من/إلى 10.10.10.25 لا يُحسب على باقته
#        (لو سرعته 3 ميجا، البث يتجاوز هذا الحد ويعمل بسرعة كاملة)
# Winbox → New Terminal → الصق كامل السكربت → Enter
# ═══════════════════════════════════════════════════════════════

# ملاحظة: هذه الطريقة تعمل مع Simple Queues ومع حد سرعة PPPoE
#         (لأن RouterOS ينشئ Simple Queue لكل جلسة PPPoE).
#         الطابور الموضوع في الأعلى (place-before=0) يلتقط ترافيك
#         سيرفر البث قبل طابور العميل، فلا يخضع لحد السرعة.

# ── 1) حذف أي استثناء سابق بنفس التعليق (لتفادي التكرار) ──
/queue simple remove [find where comment="بث: استثناء السرعة لسيرفر البث"]

# ── 2) إضافة طابور الاستثناء في أعلى القائمة ──
#    target=0.0.0.0/0 + dst=10.10.10.25  ⇒ يشمل كل العملاء، الاتجاهين (رفع/تنزيل)
#    max-limit=1000M/1000M ⇒ بلا حد فعلي (سرعة كاملة)
/queue simple add name="stream-speed-bypass" \
  target=0.0.0.0/0 dst=10.10.10.25/32 \
  max-limit=1000M/1000M priority=1/1 \
  comment="بث: استثناء السرعة لسيرفر البث" place-before=0

# ── 3) تحقق ──
:put "=== طابور الاستثناء (لازم يكون في الأعلى) ==="
/queue simple print where comment="بث: استثناء السرعة لسيرفر البث"
:put "=== تم — جرّب من عميل سرعته محدودة وراقب سرعة البث ==="

# ───────────────────────────────────────────────────────────────
# لو تبيّن أنك تستخدم Queue Tree (وليس Simple Queue) لتحديد السرعة
# ولم ينفع الاستثناء أعلاه، أرسل لي ناتج:  /queue tree print
# وسأضيف قاعدة mangle تستثني ترافيك 10.10.10.25 من علامات الـ mark.
# ───────────────────────────────────────────────────────────────
