<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- السيرفر المحلي يعمل عادةً على http بلا شهادة — نسمح بالنص الصريح لكل النطاقات -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
