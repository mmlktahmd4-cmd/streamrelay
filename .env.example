# ─── Application ───────────────────────────────────────────
NODE_ENV=production
API_PORT=3000
API_HOST=0.0.0.0
SERVER_ID=node-1
SERVER_ROLE=full
# Roles: full | api-only | stream-only

# ─── Security ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
URL_SIGNING_SECRET=change-me-url-signing-secret-min-32-chars
SIGNED_URL_TTL=3600

# ─── Database ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=streamrelay
POSTGRES_USER=streamrelay
POSTGRES_PASSWORD=change-me-db-password

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Streaming ─────────────────────────────────────────────
HLS_OUTPUT_DIR=/var/www/hls
VOD_DIR=/var/www/vod
MPEGTS_OUTPUT_DIR=/var/www/mpegts
FFMPEG_PATH=/usr/bin/ffmpeg
MAX_CONCURRENT_STREAMS=200
HEALTH_CHECK_INTERVAL=15
MAX_RESTART_ATTEMPTS=0
RESTART_COOLDOWN=5
STARTUP_RECOVERY_DELAY_SEC=5

# ─── Network / Public URLs (يُملأ تلقائياً عند التثبيت) ─────
# SERVER_IP=192.168.1.100
# SERVER_LAN_SUBNET=192.168.1.0/24
STREAMRELAY_HTTP_PORT=8080
PUBLIC_BASE_URL=http://192.168.5.102:8080
RTMP_INGEST_URL=rtmp://localhost:1935/live
HLS_BASE_URL=http://localhost/api/hls
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ─── Multi-server (سيرفرات بث بعيدة) ───────────────────────
# افتح Postgres/Redis للشبكة المحلية (غيّر 127.0.0.1 إلى 0.0.0.0 عند الحاجة)
# POSTGRES_PUBLISH=0.0.0.0:5432
# REDIS_PUBLISH=0.0.0.0:6379

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
STREAM_RATE_LIMIT_MAX=30

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=/var/log/streamrelay

# ─── Admin Bootstrap (first run only) ──────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_EMAIL=admin@localhost
ADMIN_SYNC_PASSWORD=true
